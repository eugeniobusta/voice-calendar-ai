# ── AI provider ───────────────────────────────────────────────────────────
# "groq"   → cloud (needs internet + API key below)
# "ollama" → fully local, no internet, no key  (brew install ollama first)
AI_PROVIDER=groq

# ── Groq — cloud AI (used when AI_PROVIDER=groq) ──────────────────────────
# Free API key at: https://console.groq.com (no credit card)
GROQ_API_KEY=gsk_your-key-here
GROQ_MODEL=llama-3.3-70b-versatile

# ── Ollama — local AI (used when AI_PROVIDER=ollama) ──────────────────────
# 1. brew install ollama
# 2. ollama pull llama3.2
# 3. ollama serve  (starts the local server, or it auto-starts)
# 4. Change AI_PROVIDER=ollama above
OLLAMA_MODEL=llama3.2
OLLAMA_HOST=http://localhost:11434

# ── Local Whisper — CLI only ───────────────────────────────────────────────
# tiny | base | small | medium | large
WHISPER_MODEL=base

# ── Apple Calendar — CLI / Mac only ───────────────────────────────────────
# Default calendar when AI can't determine the right one
# The system auto-reads ALL your calendars — no need to list them here
CALENDAR_NAME=Personal

# ── Storage ───────────────────────────────────────────────────────────────
DB_PATH=data/events.db

# ── Web app settings ──────────────────────────────────────────────────────
# A password to protect your web app. Choose anything strong.
APP_SECRET=choose_a_strong_password_here

# Your timezone. Find yours: https://en.wikipedia.org/wiki/List_of_tz_database_time_zones
# Common ones: America/New_York | America/Los_Angeles | America/Chicago
#              Europe/London | Europe/Paris | Europe/Rome | America/Sao_Paulo
TIMEZONE=America/New_York

# ── Google Calendar — web app only ───────────────────────────────────────
# Run setup_google_auth.py once on your Mac to get these three values.
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret
GOOGLE_REFRESH_TOKEN=your-refresh-token

# ── Telegram bot ──────────────────────────────────────────────────────────
# 1. Open Telegram → search @BotFather → /newbot → follow prompts → copy token
# 2. Send /start to your new bot → it replies with your chat ID
TELEGRAM_BOT_TOKEN=your-bot-token-here
TELEGRAM_CHAT_ID=your-numeric-chat-id

# ── Render URL (used by setup_telegram_webhook.py) ───────────────────────
RENDER_URL=https://your-app.onrender.com

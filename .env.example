# Groq API key — get yours FREE (no credit card) at: https://console.groq.com
# Sign up with email → API Keys → Create → paste it here
GROQ_API_KEY=gsk_your-key-here

# Groq model to use. llama-3.3-70b-versatile is the best free option.
# Other free options: llama-3.1-8b-instant (faster, slightly less accurate)
GROQ_MODEL=llama-3.3-70b-versatile

# Whisper model size: tiny | base | small | medium | large
# "base" is the sweet spot: ~300MB RAM, fast enough on any laptop
WHISPER_MODEL=base

# Your Apple Calendar name — must match EXACTLY (case-sensitive)
# Open Calendar app and check the left sidebar for the name
CALENDAR_NAME=Home

# SQLite database path (folder is created automatically)
DB_PATH=data/events.db

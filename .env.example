# ── Groq (required for everything) ───────────────────────────────────────
# Free API key at: https://console.groq.com (no credit card)
GROQ_API_KEY=gsk_your-key-here
GROQ_MODEL=llama-3.3-70b-versatile

# ── Local Whisper — CLI only (not used in web app) ────────────────────────
# tiny | base | small | medium | large
WHISPER_MODEL=base

# ── Apple Calendar — CLI / Mac only ──────────────────────────────────────
# Must match your calendar name exactly (check Calendar app left sidebar)
CALENDAR_NAME=Home

# ── Storage ───────────────────────────────────────────────────────────────
DB_PATH=data/events.db

# ── Web app settings ──────────────────────────────────────────────────────
# A password to protect your web app. Choose anything strong.
APP_SECRET=choose_a_strong_password_here

# Your timezone. Find yours: https://en.wikipedia.org/wiki/List_of_tz_database_time_zones
# Common ones: America/New_York | America/Los_Angeles | America/Chicago
#              Europe/London | Europe/Paris | Europe/Rome | America/Sao_Paulo
TIMEZONE=America/New_York

# ── Google Calendar — web app only ───────────────────────────────────────
# Run setup_google_auth.py once on your Mac to get these three values.
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret
GOOGLE_REFRESH_TOKEN=your-refresh-token
